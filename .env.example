# NEXUS Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus_db

# DuckDB Path
DUCKDB_PATH=data/nexus_jobs.duckdb

# OpenAI API Key (optional - enables GPT-4o for tutoring agents)
# Leave empty to use deterministic test mode
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# NLP Model Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GLINER_MODEL=urchade/gliner_base
SIMILARITY_THRESHOLD=0.82
MASTERY_THRESHOLD=0.8
